<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Paint Tits!</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F8F0F2; --panel:#FFFDFB; --ink:#3E2A2E; --ink-soft:#9A7A80;
    --accent:#C45B6E; --soft:#E8A0B0; --line:#EAD8DC;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;min-height:100vh;background:var(--bg);
    background-image:
      radial-gradient(circle at 10% 12%, #F5E0E6 0%, transparent 40%),
      radial-gradient(circle at 90% 88%, #F0E4E8 0%, transparent 42%);
    font-family:'Quicksand', sans-serif;color:var(--ink);
    display:flex;justify-content:center;padding:20px 14px 48px;
  }
  .wrap{width:100%;max-width:480px;}
  header{text-align:center;margin-bottom:14px;}
  h1{font-family:'Baloo 2',sans-serif;font-weight:800;font-size:clamp(26px,7vw,34px);margin:0 0 4px;color:var(--accent);}
  header p{margin:0;color:var(--ink-soft);font-weight:600;font-size:13px;}

  .style-tabs{display:flex;justify-content:center;gap:8px;margin:16px 0 14px;flex-wrap:wrap;}
  .style-tab{
    border:2px solid var(--line);background:var(--panel);border-radius:16px;
    padding:9px 16px;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:14px;
    color:var(--ink-soft);cursor:pointer;transition:all .15s ease;
  }
  .style-tab.active{border-color:var(--accent);color:var(--accent);background:#FDF0F3;transform:translateY(-2px);}

  .card{background:var(--panel);border-radius:22px;padding:16px;box-shadow:0 10px 30px rgba(62,42,46,0.10);border:1px solid var(--line);}
  .progress-row{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .progress-track{flex:1;height:10px;border-radius:6px;background:#F0E4E8;overflow:hidden;}
  .progress-fill{height:100%;border-radius:6px;background:linear-gradient(90deg,var(--accent),var(--soft));width:0%;transition:width .35s ease;}
  .progress-label{font-size:12px;font-weight:700;color:var(--ink-soft);white-space:nowrap;}

  .palette{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:16px;}
  .swatch{
    width:34px;height:34px;border-radius:50%;border:3px solid transparent;
    display:flex;align-items:center;justify-content:center;
    font-family:'Baloo 2',sans-serif;font-weight:600;font-size:12px;color:rgba(0,0,0,0.55);
    cursor:pointer;transition:transform .15s ease;
  }
  .swatch.selected{border-color:var(--accent);transform:scale(1.14);}
  .swatch.done{opacity:0.35;}
  .swatch:active{transform:scale(0.94);}

  .grid-shell{
    width:100%;aspect-ratio:1;background:#FFFFFF;
    border-radius:14px;padding:6px;border:1px solid var(--line);container-type:inline-size;
  }
  .grid-shell.previewing{border:2px solid var(--accent);}
  .grid{display:grid;grid-template-columns:repeat(var(--cols), 1fr);grid-template-rows:repeat(var(--rows), 1fr);width:100%;height:100%;gap:1px;border-radius:8px;overflow:hidden;}
  .cell{display:flex;align-items:center;justify-content:center;font-family:'Quicksand', sans-serif;font-weight:700;user-select:none;-webkit-tap-highlight-color:transparent;min-width:0;min-height:0;overflow:hidden;}
  .cell.empty{background:transparent;}
  .cell.blank{background:#FDFAF8;color:#C9B0B4;font-size:clamp(3px, calc(100cqw / var(--cols) * 0.55), 13px);cursor:pointer;border:1px solid #F0E4E8;}
  .cell.blank:active{background:#F8ECEF;}
  .cell.filled{color:transparent;animation:pop .28s ease;}
  .cell.shake{animation:shake .3s ease;}

  @keyframes pop{0%{transform:scale(0.55);}60%{transform:scale(1.12);}100%{transform:scale(1);}}
  @keyframes shake{0%,100%{transform:translateX(0);}25%{transform:translateX(-3px);}75%{transform:translateX(3px);}}

  .controls{display:flex;justify-content:center;gap:18px;margin-top:16px;flex-wrap:wrap;}
  .reset-btn{border:none;background:transparent;color:var(--ink-soft);font-family:'Quicksand',sans-serif;font-weight:700;font-size:13px;text-decoration:underline;cursor:pointer;padding:6px 10px;}

  .overlay{position:fixed;inset:0;background:rgba(62,42,46,0.55);display:none;align-items:center;justify-content:center;padding:24px;z-index:10;}
  .overlay.show{display:flex;}
  .celebrate-card{background:var(--panel);border-radius:22px;padding:28px 24px;text-align:center;max-width:320px;animation:pop .35s ease;border:1px solid var(--line);}
  .celebrate-card h2{font-family:'Baloo 2',sans-serif;margin:0 0 6px;font-size:24px;color:var(--accent);}
  .celebrate-card p{margin:0 0 18px;color:var(--ink-soft);font-weight:600;font-size:14px;}
  .celebrate-card button{border:none;background:var(--accent);color:white;font-family:'Baloo 2',sans-serif;font-weight:700;font-size:15px;padding:12px 22px;border-radius:14px;cursor:pointer;}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>Paint Tits!</h1>
    <p>Tap a color, then tap the matching square</p>
  </header>

  <div class="style-tabs" id="styleTabs">
    <button class="style-tab active" data-set="0">Set 1</button>
    <button class="style-tab" data-set="1">Set 2</button>
    <button class="style-tab" data-set="2">Set 3</button>
    <button class="style-tab" data-set="3">Set 4</button>
  </div>

  <div class="card">
    <div class="progress-row">
      <div class="progress-track"><div class="progress-fill" id="progressFill"></div></div>
      <div class="progress-label" id="progressLabel">0%</div>
    </div>
    <div class="palette" id="palette"></div>
    <div class="grid-shell" id="gridShell"><div class="grid" id="grid"></div></div>
    <div class="controls">
      <button class="reset-btn" id="resetBtn">Clear this painting</button>
      <button class="reset-btn" id="peekBtn">Peek at the finished painting</button>
    </div>
  </div>
</div>

<div class="overlay" id="overlay">
  <div class="celebrate-card">
    <h2>You did it!</h2>
    <p id="celebrateText">You painted those perfect soft pink tits. Nice work!</p>
    <button id="celebrateClose">Done!</button>
  </div>
</div>

