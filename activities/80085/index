let currentSet = 0;
let selectedNum = null;
let previewMode = false;
let filledState = {};

SETS.forEach(s => filledState[s.id] = new Set());

const styleTabsEl = document.getElementById('styleTabs');
const paletteEl = document.getElementById('palette');
const gridShellEl = document.getElementById('gridShell');
const gridEl = document.getElementById('grid');
const progressFill = document.getElementById('progressFill');
const progressLabel = document.getElementById('progressLabel');
const overlay = document.getElementById('overlay');
const resetBtn = document.getElementById('resetBtn');
const peekBtn = document.getElementById('peekBtn');

function activePicture(){ return SETS[currentSet]; }

function totalPaintable(picture){
  let n=0;
  picture.grid.forEach(row => row.forEach(v => { if(v !== 0) n++; }));
  return n;
}

styleTabsEl.querySelectorAll('.style-tab').forEach(btn => {
  btn.onclick = () => {
    currentSet = parseInt(btn.dataset.set);
    selectedNum = null;
    previewMode = false;
    styleTabsEl.querySelectorAll('.style-tab').forEach(b => b.classList.toggle('active', b === btn));
    renderAll();
  };
});

function countRemaining(picture, num, filled){
  let n=0;
  picture.grid.forEach((row,r) => row.forEach((v,c) => {
    if(v === num && !filled.has(r+'-'+c)) n++;
  }));
  return n;
}

function renderPalette(){
  const picture = activePicture();
  const filled = filledState[picture.id];
  paletteEl.innerHTML = '';
  const nums = Object.keys(picture.palette).map(Number).sort((a,b)=>a-b);
  nums.forEach(num => {
    const remaining = countRemaining(picture, num, filled);
    const sw = document.createElement('div');
    sw.className = 'swatch' + (selectedNum===num?' selected':'') + (remaining===0?' done':'');
    sw.style.background = picture.palette[num];
    sw.textContent = remaining===0 ? '✓' : num;
    sw.onclick = () => {
      if(remaining===0) return;
      selectedNum = (selectedNum===num) ? null : num;
      renderPalette();
      renderSquares();
    };
    paletteEl.appendChild(sw);
  });
}

function renderSquares(){
  const picture = activePicture();
  gridEl.style.setProperty('--cols', picture.cols);
  gridEl.style.setProperty('--rows', picture.rows);
  gridShellEl.classList.toggle('previewing', previewMode);
  gridEl.innerHTML = '';
  const filled = filledState[picture.id];
  picture.grid.forEach((row,r) => {
    row.forEach((v,c) => {
      const cell = document.createElement('div');
      const key = r+'-'+c;
      if(v === 0){
        cell.className = 'cell empty';
      } else if(previewMode || filled.has(key)){
        cell.className = 'cell filled';
        cell.style.background = picture.palette[v];
      } else {
        cell.className = 'cell blank';
        cell.textContent = v;
        cell.onclick = () => handleClick(picture, r, c, v, cell);
      }
      gridEl.appendChild(cell);
    });
  });
}

function handleClick(picture, r, c, value, cellEl){
  if(selectedNum === null || value !== selectedNum){
    cellEl.classList.remove('shake');
    void cellEl.offsetWidth;
    cellEl.classList.add('shake');
    return;
  }
  filledState[picture.id].add(r+'-'+c);
  renderSquares();
  renderPalette();
  updateProgress();
  checkComplete();
}

function updateProgress(){
  const picture = activePicture();
  const filled = filledState[picture.id];
  const total = totalPaintable(picture);
  const done = filled.size;
  const pct = total === 0 ? 0 : Math.round((done/total)*100);
  progressFill.style.width = pct + '%';
  progressLabel.textContent = pct + '%';
}

function checkComplete(){
  const picture = activePicture();
  const filled = filledState[picture.id];
  const total = totalPaintable(picture);
  if(filled.size === total){
    document.getElementById('celebrateText').textContent = picture.celebrateText;
    setTimeout(() => overlay.classList.add('show'), 250);
  }
}

resetBtn.onclick = () => {
  const picture = activePicture();
  filledState[picture.id] = new Set();
  selectedNum = null;
  previewMode = false;
  renderAll();
};

peekBtn.onclick = () => {
  previewMode = !previewMode;
  peekBtn.textContent = previewMode ? 'Back to my painting' : 'Peek at the finished painting';
  renderSquares();
  renderPalette();
};

document.getElementById('celebrateClose').onclick = () => overlay.classList.remove('show');

function renderAll(){
  renderPalette();
  renderSquares();
  updateProgress();
  peekBtn.textContent = previewMode ? 'Back to my painting' : 'Peek at the finished painting';
}

renderAll();
